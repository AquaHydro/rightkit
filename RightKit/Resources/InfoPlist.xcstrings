{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "NSAppleEventsUsageDescription": {
      "comment": "F-001 重启访达时的自动化授权说明",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "RightKit asks Finder to restart only after you confirm, so its context menu can take effect."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "RightKit 只在你确认后请访达重新启动，让右键菜单生效。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "RightKitは、確認後にFinderを再起動してコンテキストメニューを有効にするため、Finderの操作を求めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "RightKit은 사용자가 확인한 후 Finder를 다시 시작하여 단축 메뉴를 활성화하기 위해 Finder 제어 권한을 요청합니다."
          }
        }
      }
    }
  },
  "version": "1.0"
}
