  "strings": {
    "用 ${applicationName} 拷贝路径": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy path with ${applicationName}"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用 ${applicationName} 拷贝路径"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "${applicationName}でパスをコピー"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "${applicationName}에서 경로 복사"
          }
        }
      }
    },
    "用 ${applicationName} 新建文件": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New file with ${applicationName}"
          }
