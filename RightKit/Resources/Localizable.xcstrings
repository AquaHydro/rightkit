{
  "sourceLanguage": "zh-Hans",
  "version": "1.0",
  "strings": {
    "名称": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Name"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "名称"
          }
        }
      }
    },
    "图片": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Images"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图片"
          }
        }
      }
    },
    "图片格式": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Image Format"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图片格式"
          }
        }
      }
    },
    "在原图旁边生成 .iconset 和 .icns。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Creates an .iconset and .icns next to the image."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在原图旁边生成 .iconset 和 .icns。"
          }
        }
      }
    },
    "在原图旁边生成一组 iOS 图标 PNG。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Creates a set of iOS icon PNGs next to the image."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在原图旁边生成一组 iOS 图标 PNG。"
          }
        }
      }
    },
    "在应用中打开": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open in App"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在应用中打开"
          }
        }
      }
    },
    "在本机把文本生成二维码，打开二维码窗口。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Creates a QR code from text on this Mac and opens the QR code window."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在本机把文本生成二维码，打开二维码窗口。"
          }
        }
      }
    },
    "应用": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "App"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用"
          }
        }
      }
    },
    "打开工具": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "App"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开工具"
          }
        }
      }
    },
    "把图片转换成 PNG、JPEG、HEIC 或 TIFF，输出在原图旁边。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Converts images to PNG, JPEG, HEIC, or TIFF next to the originals."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把图片转换成 PNG、JPEG、HEIC 或 TIFF，输出在原图旁边。"
          }
        }
      }
    },
    "把项目在访达中显示的名称拷贝到剪贴板，多项时每项一行。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copies the names Finder shows for the items, one per line."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把项目在访达中显示的名称拷贝到剪贴板，多项时每项一行。"
          }
        }
      }
    },
    "把项目的路径拷贝到剪贴板，多项时每项一行。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copies the paths of the items to the clipboard, one per line."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把项目的路径拷贝到剪贴板，多项时每项一行。"
          }
        }
      }
    },
    "拷贝名称": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy Name"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拷贝名称"
          }
        }
      }
    },
