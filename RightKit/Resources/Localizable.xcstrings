    "生成二维码": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make QR Code"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "生成二维码"
          }
        }
      }
    },
    "用内置类型或自定义模板新建文件。没有指定文件夹时创建在桌面。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Creates a file from a built-in type or custom template. Without a folder, it’s created on the desktop."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用内置类型或自定义模板新建文件。没有指定文件夹时创建在桌面。"
          }
        }
      }
    },
    "终端打开所在文件夹，编辑器打开项目本身。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminals open the containing folder; editors open the items themselves."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "终端打开所在文件夹，编辑器打开项目本身。"
          }
        }
      }
    },
    "计算文件的 MD5、SHA-1、SHA-256 和 SHA-512。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculates the MD5, SHA-1, SHA-256, and SHA-512 of a file."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "计算文件的 MD5、SHA-1、SHA-256 和 SHA-512。"
          }
        }
      }
    },
    "转换图片": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Convert Image"
          }
        },
        "zh-Hans": {
