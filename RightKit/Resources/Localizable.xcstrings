    "生成 macOS 图标集": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make macOS Icon Set"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
