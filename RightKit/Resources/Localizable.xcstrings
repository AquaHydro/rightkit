    "生成 iOS 图标集": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make iOS Icon Set"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "生成 iOS 图标集"
          }
        }
      }
