    "生成 iOS 图标集": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make iOS Icon Set"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "生成 iOS 图标集"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOSアイコンセットを作成"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 아이콘 세트 생성"
          }
        }
      }
    },
    "生成 macOS 图标集": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make macOS Icon Set"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "生成 macOS 图标集"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOSアイコンセットを作成"
          }
        },
