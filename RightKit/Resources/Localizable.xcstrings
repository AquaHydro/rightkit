{
  "sourceLanguage": "zh-Hans",
  "version": "1.0",
  "strings": {
    "名称": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Name"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "名称"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이름"
          }
        }
      }
    },
    "图片": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Images"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图片"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미지"
          }
        }
      }
    },
    "图片格式": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Image Format"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图片格式"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像形式"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미지 형식"
          }
        }
      }
    },
    "在原图旁边生成 .iconset 和 .icns。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Creates an .iconset and .icns next to the image."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在原图旁边生成 .iconset 和 .icns。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元の画像と同じ場所に .iconset と .icns を作成します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원본 이미지 옆에 .iconset 및 .icns 파일을 생성합니다."
          }
        }
      }
    },
    "在原图旁边生成一组 iOS 图标 PNG。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Creates a set of iOS icon PNGs next to the image."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在原图旁边生成一组 iOS 图标 PNG。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元の画像と同じ場所に iOS アイコン用の PNG ファイル一式を作成します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원본 이미지 옆에 iOS 아이콘용 PNG 파일 세트를 생성합니다."
          }
        }
      }
    },
    "在应用中打开": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open in App"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在应用中打开"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリで開く"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱으로 열기"
          }
        }
      }
    },
    "在本机把文本生成二维码，打开二维码窗口。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Creates a QR code from text on this Mac and opens the QR code window."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在本机把文本生成二维码，打开二维码窗口。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacでテキストからQRコードを作成し、QRコードのウインドウを開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac에서 텍스트로 QR 코드를 생성하고 QR 코드 창을 엽니다."
          }
        }
      }
    },
    "应用": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "App"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱"
          }
        }
      }
    },
    "打开工具": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "App"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开工具"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開くアプリ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "열기 앱"
          }
        }
      }
    },
    "把图片转换成 PNG、JPEG、HEIC 或 TIFF，输出在原图旁边。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Converts images to PNG, JPEG, HEIC, or TIFF next to the originals."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把图片转换成 PNG、JPEG、HEIC 或 TIFF，输出在原图旁边。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像を PNG、JPEG、HEIC、または TIFF に変換し、元の画像と同じ場所に保存します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미지를 PNG, JPEG, HEIC 또는 TIFF로 변환하여 원본 이미지 옆에 저장합니다."
          }
        }
      }
    },
    "把项目在访达中显示的名称拷贝到剪贴板，多项时每项一行。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copies the names Finder shows for the items, one per line."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把项目在访达中显示的名称拷贝到剪贴板，多项时每项一行。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Finderに表示される項目名をクリップボードにコピーします。複数の項目は1行に1つずつ記載します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder에 표시되는 항목 이름을 클립보드에 복사합니다. 여러 항목은 한 줄에 하나씩 복사합니다."
          }
        }
      }
    },
    "把项目的路径拷贝到剪贴板，多项时每项一行。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copies the paths of the items to the clipboard, one per line."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把项目的路径拷贝到剪贴板，多项时每项一行。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "項目のパスをクリップボードにコピーします。複数の項目は1行に1つずつ記載します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "항목의 경로를 클립보드에 복사합니다. 여러 항목은 한 줄에 하나씩 복사합니다."
          }
        }
      }
    },
    "拷贝名称": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy Name"
