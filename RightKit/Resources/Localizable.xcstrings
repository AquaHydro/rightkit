            "state": "translated",
            "value": "macOS 아이콘 세트 생성"
          }
        }
      }
    },
    "生成二维码": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make QR Code"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "生成二维码"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "QRコードを作成"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "QR 코드 생성"
          }
        }
      }
    },
    "用内置类型或自定义模板新建文件。没有指定文件夹时创建在桌面。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Creates a file from a built-in type or custom template. Without a folder, it’s created on the desktop."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用内置类型或自定义模板新建文件。没有指定文件夹时创建在桌面。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "標準のファイル形式またはカスタムテンプレートからファイルを作成します。フォルダを指定しない場合はデスクトップに作成します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본 파일 유형이나 사용자 지정 템플릿으로 파일을 생성합니다. 폴더를 지정하지 않으면 데스크탑에 생성합니다."
          }
        }
      }
    },
    "终端打开所在文件夹，编辑器打开项目本身。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminals open the containing folder; editors open the items themselves."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "终端打开所在文件夹，编辑器打开项目本身。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ターミナルでは項目が入っているフォルダを、エディタでは項目自体を開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "터미널은 항목이 있는 폴더를 열고, 편집기는 항목 자체를 엽니다."
          }
        }
      }
    },
    "计算文件的 MD5、SHA-1、SHA-256 和 SHA-512。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculates the MD5, SHA-1, SHA-256, and SHA-512 of a file."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "计算文件的 MD5、SHA-1、SHA-256 和 SHA-512。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルの MD5、SHA-1、SHA-256、SHA-512 を計算します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일의 MD5, SHA-1, SHA-256 및 SHA-512를 계산합니다."
          }
        }
      }
    },
    "转换图片": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Convert Image"
