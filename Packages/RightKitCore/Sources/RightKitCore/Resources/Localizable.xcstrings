    "仅支持为文件计算哈希。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hashes can only be calculated for files."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅支持为文件计算哈希。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ハッシュ値を計算できるのはファイルのみです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일의 해시만 계산할 수 있습니다."
          }
        }
      }
    },
    "你正在使用 %@。前往下载页面获取新版本。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You’re using %@. Go to the download page to get the new version."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你正在使用 %@。前往下载页面获取新版本。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在 %@ を使用しています。ダウンロードページで新しいバージョンを入手できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 사용 중인 버전은 %@입니다. 다운로드 페이지에서 새 버전을 받으세요."
          }
        }
      }
    },
    "使用该文件类型的默认应用打开。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens with the default app for that file type."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用该文件类型的默认应用打开。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このファイル形式のデフォルトアプリで開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 파일 유형의 기본 앱으로 엽니다."
          }
        }
      }
    },
