            "state": "translated",
            "value": "Send To"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发送到"
          }
        }
      }
    },
    "发送替身到桌面": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make Alias on Desktop"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发送替身到桌面"
          }
