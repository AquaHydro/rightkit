{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "%@ 已授权": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” authorized"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已授权"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」は許可済み"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 접근 허용됨"
          }
        }
      }
    },
    "Excel 工作簿": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Excel Workbook"
          }
