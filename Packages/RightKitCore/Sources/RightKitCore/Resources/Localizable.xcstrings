          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "RTF 문서"
          }
        }
      }
    },
    "RightKit %@ 可用": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "RightKit %@ Is Available"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "RightKit %@ 可用"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "RightKit %@ が利用可能です"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "RightKit %@ 사용 가능"
          }
        }
      }
    },
    "RightKit 仅在这些文件夹及其子文件夹的访达菜单中显示。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "RightKit appears in Finder menus only inside these folders and their subfolders."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "RightKit 仅在这些文件夹及其子文件夹的访达菜单中显示。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "RightKit はこれらのフォルダとそのサブフォルダの Finder メニューにのみ表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "RightKit은 이 폴더와 하위 폴더의 Finder 메뉴에만 표시됩니다."
          }
        }
      }
    },
    "RightKit 只能在你授权的文件夹里新建、复制和整理文件。建议授权个人主文件夹。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "RightKit can only create, copy, and organize files in folders you authorize. Authorizing your home folder is recommended."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "RightKit 只能在你授权的文件夹里新建、复制和整理文件。建议授权个人主文件夹。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "RightKit はアクセスを許可したフォルダ内でのみファイルの作成、コピー、整理ができます。ホームフォルダへのアクセスを許可することをおすすめします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "RightKit은 접근을 허용한 폴더에서만 파일을 생성, 복사, 정리할 수 있습니다. 홈 폴더에 대한 접근을 허용하는 것이 좋습니다."
          }
        }
      }
    },
    "RightKit 已是最新版本。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "RightKit is up to date."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "RightKit 已是最新版本。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "RightKit は最新バージョンです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "RightKit이 최신 버전입니다."
          }
        }
      }
    },
    "RightKit 无权访问“%@”。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "RightKit can’t access “%@”."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "RightKit 无权访问“%@”。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "RightKit は「%@」にアクセスできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "RightKit이 ‘%@’에 접근할 수 없습니다."
          }
        }
      }
    },
    "Shell 脚本": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shell Script"
          }
        },
        "zh-Hans": {
