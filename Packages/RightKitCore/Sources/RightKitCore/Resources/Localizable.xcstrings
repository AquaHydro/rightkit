    "语言": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Language"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "语言"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "言語"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "언어"
          }
        }
      }
    },
    "请在“系统设置 → 通用 → 登录项与扩展 → 允许在后台”中打开 RightKit。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on RightKit in System Settings → General → Login Items & Extensions → Allow in the Background."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在“系统设置 → 通用 → 登录项与扩展 → 允许在后台”中打开 RightKit。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「システム設定 → 一般 → ログイン項目と機能拡張 → バックグラウンドでの実行を許可」で RightKit をオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘시스템 설정 → 일반 → 로그인 항목 및 확장 프로그램 → 백그라운드에서 허용’에서 RightKit을 켜세요."
          }
        }
      }
    },
    "请在“系统设置 → 隐私与安全性 → 自动化”中允许 RightKit 控制访达，或按住 Option 键右键点按程序坞中的访达，选择“重新开启”。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow RightKit to control Finder in System Settings → Privacy & Security → Automation, or Option-right-click Finder in the Dock and choose Relaunch."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在“系统设置 → 隐私与安全性 → 自动化”中允许 RightKit 控制访达，或按住 Option 键右键点按程序坞中的访达，选择“重新开启”。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「システム設定 → プライバシーとセキュリティ → オートメーション」で RightKit に Finder の操作を許可するか、Option キーを押しながら Dock の Finder を右クリックして「再度開く」を選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘시스템 설정 → 개인정보 보호 및 보안 → 자동화’에서 RightKit이 Finder를 제어하도록 허용하거나, Option 키를 누른 채 Dock의 Finder를 오른쪽 클릭하고 ‘재실행’을 선택하세요."
          }
        }
      }
    },
    "请在设置里把它所在的文件夹加入监视目录；如果那个文件夹显示「需要重新授权。」，点「重新授权…」。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In Settings, add the folder that contains it to Monitored Folders. If that folder shows “Needs authorization again.”, click “Authorize Again…”."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在设置里把它所在的文件夹加入监视目录；如果那个文件夹显示「需要重新授权。」，点「重新授权…」。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定で対象のフォルダを監視フォルダに追加してください。そのフォルダに「再度アクセスを許可してください。」と表示されている場合は、「再度アクセスを許可…」をクリックしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정에서 해당 폴더를 감시 폴더에 추가하세요. 폴더에 ‘접근 허용이 다시 필요합니다.’가 표시되면 ‘다시 접근 허용…’을 클릭하세요."
          }
        }
      }
    },
