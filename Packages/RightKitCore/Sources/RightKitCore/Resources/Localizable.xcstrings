        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "好"
          }
        }
      }
    },
    "如果菜单项没有立即出现，请重启一次访达。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the menu items don’t appear right away, restart Finder once."
