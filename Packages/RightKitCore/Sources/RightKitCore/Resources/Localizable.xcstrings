            "state": "translated",
            "value": "Shell 脚本"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シェルスクリプト"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "셸 스크립트"
          }
        }
      }
    },
    "Word 文档": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Word Document"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Word 文档"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Word 書類"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Word 문서"
          }
        }
      }
    },
    "iconutil 生成 ICNS 文件失败。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iconutil couldn’t create the ICNS file."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iconutil 生成 ICNS 文件失败。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iconutil で ICNS ファイルを生成できませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iconutil이 ICNS 파일을 생성하지 못했습니다."
          }
        }
      }
    },
    "“%@”不是可读取的图片。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” isn’t a readable image."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”不是可读取的图片。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」は読み込み可能な画像ではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "읽을 수 없는 이미지입니다: ‘%@’."
          }
        }
      }
    },
    "“%@”已不在系统中。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” is no longer on this Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”已不在系统中。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」はこの Mac にありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac에서 더 이상 찾을 수 없습니다: ‘%@’."
          }
        }
      }
    },
    "一切就绪，去访达里右键试试。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All set. Try right-clicking in Finder."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一切就绪，去访达里右键试试。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "準備ができました。Finder で右クリックしてみましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "준비가 끝났습니다. Finder에서 오른쪽 클릭해 보세요."
          }
        }
      }
    },
    "不能添加根目录、系统目录，或个人主目录的上级目录。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can’t add the startup disk root, a system folder, or a folder that contains your home folder."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不能添加根目录、系统目录，或个人主目录的上级目录。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ルートフォルダ、システムフォルダ、ホームフォルダの親フォルダは追加できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "루트 폴더, 시스템 폴더 또는 홈 폴더의 상위 폴더는 추가할 수 없습니다."
          }
        }
      }
    },
    "主题": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
