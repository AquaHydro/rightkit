          "stringUnit": {
            "state": "translated",
            "value": "拖动可调整菜单中的顺序。"
          }
        }
      }
    },
    "拖动可调整顺序。解散文件夹和彻底删除始终在菜单最后。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag to reorder. Dissolve Folder and Delete Permanently always stay at the end of the menu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动可调整顺序。解散文件夹和彻底删除始终在菜单最后。"
          }
        }
      }
    },
