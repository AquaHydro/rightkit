    "访达会短暂关闭并重新打开。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder will quit briefly and reopen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "访达会短暂关闭并重新打开。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder がいったん終了し、再び開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder가 잠시 종료되었다가 다시 열립니다."
          }
        }
      }
    },
    "访达右键菜单工具。新建文件、复制移动、在应用中打开，以及一组文件工具。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A Finder context menu tool for creating files, copying and moving, opening in apps, and more."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "访达右键菜单工具。新建文件、复制移动、在应用中打开，以及一组文件工具。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder の右クリックメニューツール。ファイルの作成、コピーと移動、アプリで開く操作やファイルツールを利用できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder 오른쪽 클릭 메뉴 도구입니다. 파일 생성, 복사 및 이동, 앱으로 열기와 파일 도구를 사용할 수 있습니다."
          }
        }
      }
    },
    "访达扩展已启用": {
      "localizations": {
