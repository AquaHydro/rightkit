{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "Excel 工作簿": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Excel Workbook"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Excel 工作簿"
          }
        }
      }
    },
    "PowerPoint 演示文稿": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PowerPoint Presentation"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "PowerPoint 演示文稿"
          }
        }
      }
    },
    "RTF 文稿": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rich Text"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "RTF 文稿"
          }
        }
      }
    },
    "RightKit 仅在这些文件夹及其子文件夹的访达菜单中显示。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "RightKit appears in Finder menus only inside these folders and their subfolders."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "RightKit 仅在这些文件夹及其子文件夹的访达菜单中显示。"
          }
        }
      }
    },
    "RightKit 角色": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "RightKit character"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "RightKit 角色"
          }
        }
      }
    },
    "在“系统设置 → 通用 → 登录项与扩展”中打开 RightKit 的访达扩展，右键菜单才会出现。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on the RightKit Finder extension in System Settings → General → Login Items & Extensions to see the right-click menu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“系统设置 → 通用 → 登录项与扩展”中打开 RightKit 的访达扩展，右键菜单才会出现。"
          }
        }
      }
    },
    "现在就可以在访达里右键试试。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try right-clicking in Finder now."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现在就可以在访达里右键试试。"
          }
        }
      }
    },
    "RightKit 图标": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "RightKit icon"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "RightKit 图标"
          }
        }
      }
    },
    "Shell 脚本": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shell Script"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Shell 脚本"
          }
        }
      }
    },
    "Word 文档": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Word Document"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Word 文档"
          }
        }
      }
    },
    "iconutil 生成 ICNS 文件失败。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iconutil couldn’t create the ICNS file."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iconutil 生成 ICNS 文件失败。"
          }
        }
      }
    },
    "“%@”不是可读取的图片。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” isn’t a readable image."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”不是可读取的图片。"
          }
        }
      }
    },
    "“%@”已不在系统中。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” is no longer on this Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”已不在系统中。"
          }
        }
      }
    },
    "不能添加根目录、系统目录，或个人主目录的上级目录。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can’t add the startup disk root, a system folder, or a folder that contains your home folder."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不能添加根目录、系统目录，或个人主目录的上级目录。"
          }
        }
      }
    },
    "主题": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Appearance"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主题"
          }
        }
      }
    },
    "二维码": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "QR Code"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "二维码"
          }
        }
      }
    },
    "二维码预览": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "QR code preview"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "二维码预览"
          }
        }
      }
    },
    "仅支持为文件计算哈希。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hashes can only be calculated for files."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅支持为文件计算哈希。"
          }
        }
      }
    },
    "使用该文件类型的默认应用打开。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens with the default app for that file type."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用该文件类型的默认应用打开。"
          }
        }
      }
    },
    "关于": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "About"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关于"
          }
        }
      }
    },
    "分栏": {
