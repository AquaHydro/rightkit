    "取消": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消"
          }
        }
      }
    },
    "受保护位置的拒绝提示不受这个开关影响。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Protected locations are always refused, regardless of this setting."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "受保护位置的拒绝提示不受这个开关影响。"
          }
        }
      }
    },
    "受保护的位置": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Protected Location"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "受保护的位置"
          }
        }
      }
    },
    "后台服务已关闭": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Background service is off"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "后台服务已关闭"
          }
        }
      }
    },
    "在应用中打开": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open in App"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在应用中打开"
          }
        }
      }
    },
    "在菜单项中显示图标": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show icons in menu items"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在菜单项中显示图标"
          }
        }
      }
    },
    "在访达空白处右键，一键打开这些文件夹。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Right-click empty space in Finder to open these folders."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在访达空白处右键，一键打开这些文件夹。"
          }
        }
      }
    },
    "在访达里右键，就能新建文件、把项目复制或移动到常用位置、用指定应用打开，以及使用一组文件工具。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Right-click in Finder to create files, copy or move items to favorite places, open them in your apps, and use a set of file tools."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在访达里右键，就能新建文件、把项目复制或移动到常用位置、用指定应用打开，以及使用一组文件工具。"
          }
        }
      }
    },
    "复制": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy"
          }
        },
